# Copiez ce fichier en .env (même dossier) et remplissez chaque valeur. Ne commitez jamais le .env.
# Évitez le caractère $ dans les mots de passe (Docker Compose l'interprète) ou doublez-le : $$.

# Nom de domaine qui pointe vers le serveur (enregistrement DNS A/AAAA), et e-mail pour Let's Encrypt
DOMAIN=pokequizz.example.com
ACME_EMAIL=vous@example.com

# Image SQL Server : même version majeure que votre SQL Server de dev, ou plus récente
# (une sauvegarde ne se restaure pas sur une version plus ancienne). Voir SELECT @@VERSION.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# Édition : Express (gratuite, base limitée à 10 Go) ou Developer (gratuite, hors production)
MSSQL_PID=Express

# Mot de passe sa : 8 caractères minimum, avec majuscules, minuscules, chiffres et symboles
SA_PASSWORD=

# Base restaurée : nom de la base (celui de votre base de dev) et fichier .bak déposé dans deploy/backup/
DB_NAME=
DB_BACKUP_FILE=pokequizz.bak

# Compte SQL utilisé par l'API (créé automatiquement, propriétaire de la base uniquement)
APP_DB_USER=pokequizz_app
APP_DB_PASSWORD=

# Clé de signature des jetons JWT : au moins 64 caractères aléatoires (ex. openssl rand -base64 64 | tr -d '\n')
JWT_KEY=

# Serveur SMTP pour les e-mails « mot de passe oublié » (OVH, Gmail, Brevo, etc.).
# Laissé vide : aucun e-mail n'est envoyé, le lien apparaît seulement dans les journaux de l'API (docker compose logs api).
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pokequizz.example.com

# Id (table AspNetUsers) du compte administrateur, facultatif
ADMIN_USER_ID=

# Emplacements (relatifs à ce dossier deploy/)
CONTENT_DIR=../../content
FRONT_DIR=../../PokeQuizz-Dex
